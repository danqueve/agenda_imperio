# Agenda de Cobranza - Imperio Comercial

# No listar contenido de directorios (p.ej. assets/ sin index)
Options -Indexes

# Cabeceras de seguridad basicas
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# En hosting compartido (PHP-FPM/CGI) el header Authorization a veces no
# llega a getallheaders()/$_SERVER sin esto. Relevante si cron_diario.php
# se llega a mover a un endpoint con Authorization en vez de ?token=,
# y en general como resguardo (ver DEPLOY.md).
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
