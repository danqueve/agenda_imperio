<?php
declare(strict_types=1);

/**
 * Plantilla para producción. Este archivo (junto con api_readonly.php)
 * NO se despliega en el hosting de la Agenda - se copia al hosting donde
 * vive SAS Imperio (probablemente la misma cuenta cPanel que aloja
 * c2881399_credit, a juzgar por el prefijo compartido). Es una
 * coordinación manual con quien administra ese hosting - ver DEPLOY.md.
 *
 * Cómo usar:
 *   1. Copiar este archivo (y api_readonly.php) al hosting de SAS, como
 *      sas_side/config_readonly.php (nunca commitear esa copia con las
 *      credenciales reales).
 *   2. SAS_DB_PASS: la password real que le pongas al usuario
 *      agenda_readonly al correr sql/03_sas_readonly.sql en ESE servidor
 *      (ajustar también el host/usuario del CREATE USER si ese panel no
 *      usa 'localhost').
 *   3. SAS_API_TOKEN_VALIDO: el mismo valor que generes y pongas en
 *      config/sas_api.prod.php.example del lado de la Agenda.
 */

const SAS_DB_HOST    = 'localhost'; // AJUSTAR si el hosting de SAS lo requiere
const SAS_DB_NAME    = 'c2881399_credit';
const SAS_DB_USER    = 'agenda_readonly';
const SAS_DB_PASS    = 'CAMBIAR_password_real_del_usuario_readonly'; // debe coincidir con el CREATE USER real en ese servidor
const SAS_DB_CHARSET = 'utf8mb4';

// Debe coincidir con SAS_API_TOKEN en config/sas_api.php (lado Agenda)
const SAS_API_TOKEN_VALIDO = 'CAMBIAR_generar_token_propio_de_produccion';
